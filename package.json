{
  "name": "koolcontrol",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && npx workbox-cli generateSW workbox-config.js",
    "build:ios": "eas build --platform ios",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.21",
    "@react-navigation/native-stack": "^7.6.4",
    "axios": "^1.13.2",
    "expo": "~54.0.25",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "~19.1.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "babel-preset-expo": "^54.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  },
  "license": "MIT",
  "private": true
}
